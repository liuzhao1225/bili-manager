{
  "manifest_version": 3,
  "name": "Bili Manager Cookie Uploader",
  "version": "0.2.0",
  "description": "读取当前 Chrome 中的 Bilibili Cookie，并在 Cookie 更新后自动同步到 Bili Manager。",
  "permissions": ["alarms", "cookies", "storage"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://bilibili.com/*",
    "https://*.supabase.co/*"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "上传 B 站 Cookie",
    "default_popup": "popup.html"
  }
}
